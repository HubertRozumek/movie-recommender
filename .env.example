# Environment Configuration for MovieLens Recommendation Benchmark

# Application Settings
APP_NAME=movielens-recommendation-benchmark
APP_ENV=development  # development, staging, production
APP_DEBUG=True
APP_VERSION=1.0.0

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Gradio Settings
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=False
GRADIO_AUTH_USERNAME=
GRADIO_AUTH_PASSWORD=

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_BACKEND_STORE_URI=sqlite:///experiments/mlruns/mlflow.db
MLFLOW_ARTIFACT_ROOT=experiments/mlruns/artifacts
MLFLOW_EXPERIMENT_NAME=movielens-benchmark
MLFLOW_RUN_NAME=
MLFLOW_TAGS=

# Data Configuration
DATA_DIR=data
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
INTERIM_DATA_DIR=data/interim
MOVIELENS_VERSION=ml-latest-small  # ml-100k, ml-1m, ml-10m, ml-20m, ml-latest-small, ml-latest

# Model Configuration
MODEL_DIR=results/models
MODEL_REGISTRY_PATH=results/models/registry
DEFAULT_MODEL=svd
MODEL_CACHE_SIZE=5

# Training Configuration
TRAIN_BATCH_SIZE=256
EVAL_BATCH_SIZE=512
LEARNING_RATE=0.001
NUM_EPOCHS=50
EARLY_STOPPING_PATIENCE=5
VALIDATION_SPLIT=0.2
TEST_SPLIT=0.1
RANDOM_STATE=42

# Hyperparameter Tuning
OPTUNA_N_TRIALS=100
OPTUNA_TIMEOUT=3600
OPTUNA_N_JOBS=4
OPTUNA_STUDY_NAME=movielens-optimization

# Database Configuration (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/movielens
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017/movielens

# AWS Configuration (for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=movielens-models

# Google Cloud Configuration (optional)
GOOGLE_APPLICATION_CREDENTIALS=
GCS_BUCKET_NAME=

# Azure Configuration (optional)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

# Weights & Biases Configuration
WANDB_API_KEY=
WANDB_PROJECT=movielens-benchmark
WANDB_ENTITY=
WANDB_MODE=online  # online, offline, disabled

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log
LOG_FORMAT=json  # json, plain
LOG_ROTATION=1 day
LOG_RETENTION=30 days

# Performance Configuration
MAX_WORKERS=4
THREAD_POOL_SIZE=10
CONNECTION_POOL_SIZE=20
CACHE_TTL=3600
ENABLE_PROFILING=False

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DELTA=3600
CORS_ORIGINS=http://localhost:3000,http://localhost:7860
ALLOWED_HOSTS=localhost,127.0.0.1

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc_dir
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Feature Flags
ENABLE_A_B_TESTING=True
ENABLE_CACHE=True
ENABLE_GPU=False
ENABLE_DISTRIBUTED_TRAINING=False

# API Keys for external services
TMDB_API_KEY=  # The Movie Database API
OMDB_API_KEY=  # Open Movie Database API

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# Slack Notifications (optional)
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=#ml-experiments

# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=movielens-benchmark
DOCKER_TAG=latest

# Testing
TEST_DATABASE_URL=sqlite:///test.db
TEST_DATA_DIR=tests/fixtures/data
PYTEST_WORKERS=auto

# Development Tools
JUPYTER_PORT=8888
TENSORBOARD_PORT=6006
STREAMLIT_PORT=8501

# Custom Configuration
CUSTOM_CONFIG_PATH=config/custom.yaml
EXPERIMENT_CONFIG_PATH=experiments/experiment_configs/
ENABLE_EXPERIMENTAL_FEATURES=False